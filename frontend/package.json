    "kysely-pglite": "0.6.1",
    "motion": "^13.4.2",
    "next": "16.3.5",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
