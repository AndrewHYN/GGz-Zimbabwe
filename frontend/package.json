    "db:inventory": "node --env-file=.env.local --import tsx scripts/legacy-inventory.mts",
    "test:http": "node scripts/http-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
