# Required in hosted environments. Never expose these with NEXT_PUBLIC_.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://ggz-frontend.vercel.app
# Optional local PostgreSQL-compatible database; rejected on Vercel.
# GGZ_LOCAL_DATABASE=./.local-db
# Optional integrations; credentials stay on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
EMAIL_FROM=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=ggz-media
MEDIA_PUBLIC_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Used only by the read-only legacy inventory command.
LEGACY_DATABASE_URL=
