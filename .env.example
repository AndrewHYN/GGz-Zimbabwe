# Copy this file to .env and fill in real values for your environment.
DJANGO_SECRET_KEY=
DEBUG=False

# Comma-separated hostnames for this environment.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost:8000,https://127.0.0.1:8000
# Canonical Next.js site origin. Used for OAuth callback redirects and
# frontend password-reset email links; also appended to
# CSRF_TRUSTED_ORIGINS automatically when it starts with http(s)://.
# Local dev default: http://localhost:3000 — set the real origin in production.
FRONTEND_URL=
# Vercel supplies VERCEL_URL automatically. Set this for a custom production domain if needed.
VERCEL_PROJECT_PRODUCTION_URL=

# Set this to True only when the platform terminates HTTPS and forwards the
# original protocol in X-Forwarded-Proto (Vercel production).
USE_X_FORWARDED_PROTO=False

# SQLite is the default local development database.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DATABASE_URL=

# Production deployment values should be set explicitly.
# Example PostgreSQL configuration:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ggz
# DB_USER=ggz_user
# DB_PASSWORD=replace-with-strong-password
# DB_HOST=postgres.internal
# DB_PORT=5432

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=hello_world/media

# User-uploaded media (avatars, banners, listing images) is stored on the
# local filesystem by default, which is fine for local development and any
# host with persistent disk. Serverless hosts (e.g. Vercel) have ephemeral
# disks, so production media MUST use Supabase/S3 object storage. When ALL
# variables below are set, media is served from the public Supabase bucket
# URL and uploaded through hello_world.storage.SupabaseMediaStorage.
#
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_STORAGE_BUCKET_NAME=
#   AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_S3_REGION_NAME=ap-southeast-1
#   # Optional: custom public domain for the bucket (defaults to the Supabase host).
#   AWS_S3_CUSTOM_DOMAIN=
#
# After configuring S3, sync existing local media and verify a round-trip:
#   python manage.py check_media_storage --verify-upload

# Google Maps configuration. Prefer the canonical GOOGLE_MAPS_* names.
# Legacy GGZ_MAP_* values remain supported for compatibility.
GOOGLE_MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_LATITUDE=-17.8252
GOOGLE_MAPS_DEFAULT_LONGITUDE=31.0335

# GGz Companion. Keep provider credentials server-side.
AI_COMPANION_PROVIDER=mock
AI_COMPANION_API_KEY=
AI_COMPANION_MODEL=gpt-4o-mini
AI_COMPANION_BASE_URL=

# Optional browser notification configuration. Background Web Push is enabled
# only when all VAPID values are configured server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@ggz.local

# Discord OAuth. Connect Discord lives inside the authenticated Security
# settings page; no bot or gateway is used in this milestone. Create an OAuth2
# app in the Discord Developer Portal and add the redirect URI below.
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_PLATFORM_OWNER_USERNAME=Hyndrrx

SECURE_SSL_REDIRECT=False
DB_CONN_MAX_AGE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# IGDB (Twitch) game catalogue integration. The games hub stays local-only
# while these are blank. Create a Twitch application to get credentials:
# https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional overrides (defaults shown):
# IGDB_AUTH_URL=https://id.twitch.tv/oauth2/token
# IGDB_BASE_URL=https://api.igdb.com/v4
# IGDB_TIMEOUT=8
# IGDB_SEARCH_CACHE_SECONDS=21600
# IGDB_GAME_CACHE_SECONDS=86400

# Browser-restricted Google Maps JavaScript key for the Next.js Radar UI
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
